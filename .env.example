# ========================================================
# Department Practice Platform (.env)
# ========================================================

# General & Security
ENV=development
SECRET_KEY=super-secret-system-key-change-in-production
JWT_SECRET_KEY=super-secret-jwt-key-change-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
SYSTEM_TIMEZONE=Asia/Kolkata

# Initial Super Admin (Seeded on first run if database empty)
INITIAL_ADMIN_EMAIL=admin@dept.edu
INITIAL_ADMIN_PASSWORD=AdminPassword@123
INITIAL_ADMIN_NAME="System Administrator"

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/zero1_db

# Valkey / Cache / Broker / Distributed Locks / Rate Limiting
VALKEY_URL=valkey://localhost:6379/0
CELERY_BROKER_URL=valkey://localhost:6379/0
CELERY_RESULT_BACKEND=valkey://localhost:6379/0
RATE_LIMIT_STORAGE_URL=valkey://localhost:6379/1

# Judge0 Code Execution Engine
JUDGE0_URL=http://localhost:2358
JUDGE0_AUTH_TOKEN=
JUDGE0_POLL_TIMEOUT_SECONDS=10

# AI / LLM Configuration
# Primary Provider (Leave LLM_API_KEY empty to fall back to local Ollama)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Fallback Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Platform Specifics & Cutoffs
STREAK_REQUIRES_BOTH=true
GRACE_CUTOFF_HOURS=3
MIN_MCQ_POOL_SIZE=7
MIN_CODING_POOL_SIZE=7
